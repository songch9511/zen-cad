{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "status",
    "checks",
    "summary"
  ],
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "name",
          "result"
        ],
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
