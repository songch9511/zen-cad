{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zen-cad.dev/schemas/cad_source_manifest.schema.json",
  "title": "Zen CAD Source Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "source_scene_id",
    "target_harness",
    "source_path",
    "expected_primary_artifact",
    "generated_files",
    "primitives",
    "locked_layout_facts",
    "inspection_targets",
    "source_of_truth",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": "0.8.0" },
    "kind": { "const": "cad_source_manifest" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "source_scene_id": { "type": "string" },
    "target_harness": {
      "type": "string",
      "enum": ["build123d", "cadquery", "freecad", "unknown"]
    },
    "source_path": { "type": "string" },
    "expected_primary_artifact": { "type": "string" },
    "generated_files": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "primitives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locked_layout_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inspection_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourced_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part_id", "source_lock_id", "locator", "artifact_kind", "import_strategy"],
        "properties": {
          "part_id": { "type": "string" },
          "source_lock_id": { "type": "string" },
          "locator": { "type": "string" },
          "artifact_kind": {
            "type": "string",
            "enum": ["step", "stp"]
          },
          "import_strategy": {
            "type": "string",
            "enum": ["build123d.import_step"]
          },
          "label": { "type": "string" },
          "source_type": { "type": "string" },
          "retrieval_status": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "placement_policy": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "source_of_truth": {
      "type": "object",
      "required": ["scene", "package"],
      "properties": {
        "scene": { "type": "string" },
        "package": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
