{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "connections"
  ],
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "connection_id",
          "parts",
          "type"
        ],
        "additionalProperties": true
      }
    }
  }
}
