{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "contacts"
  ],
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contact_id",
          "part_a",
          "part_b",
          "type"
        ],
        "additionalProperties": true
      }
    }
  }
}
