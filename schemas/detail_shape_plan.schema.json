{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zen-cad.dev/schemas/detail_shape_plan.schema.json",
  "title": "Zen CAD Detail Shape Plan",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "source_spec_id",
    "part_id",
    "locked_interfaces",
    "protected_zones",
    "shape_intent",
    "feature_plan",
    "inspection_required",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": "0.8.0" },
    "kind": { "const": "detail_shape_plan" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "source_spec_id": { "type": "string", "minLength": 1 },
    "part_id": { "type": "string", "minLength": 1 },
    "locked_interfaces": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "protected_zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/protected_zone" }
    },
    "shape_intent": {
      "type": "object",
      "required": ["style", "manufacturing", "wall_min_mm", "avoid"],
      "properties": {
        "style": { "type": "string", "minLength": 1 },
        "manufacturing": {
          "type": "string",
          "enum": ["unspecified", "3d_printed", "cnc_machined", "sheet_metal", "cast", "laser_cut", "hybrid"]
        },
        "wall_min_mm": { "type": "number", "minimum": 0 },
        "fillet_preference_mm": { "type": "number", "minimum": 0 },
        "avoid": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "feature_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "inspection_required": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "protected_zone": {
      "type": "object",
      "required": ["id", "around", "rule", "reason"],
      "properties": {
        "id": { "type": "string" },
        "around": { "type": "string" },
        "rule": {
          "type": "object",
          "required": ["kind", "value_mm"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["radius", "offset", "keepout_box", "motion_sweep"]
            },
            "value_mm": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": ["type", "purpose", "driven_by"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["base_envelope", "boss", "rib", "pocket", "fillet", "chamfer", "hole", "slot", "shell", "custom"]
        },
        "purpose": { "type": "string" },
        "driven_by": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
