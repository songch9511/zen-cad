{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "status",
    "checks",
    "summary"
  ],
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "maturity": {
      "enum": [
        "concept",
        "layout",
        "final"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "name",
          "result",
          "evidence_type",
          "evidence",
          "command",
          "artifacts",
          "limitations"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "evidence_type": {
            "enum": [
              "structure",
              "environment",
              "source_lock",
              "cad_generation",
              "step_load",
              "geometry_inspection",
              "physical_check",
              "visual_snapshot",
              "report",
              "other"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "command": {
            "type": "object",
            "required": [
              "argv",
              "cwd",
              "exit_code"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "role",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "name",
          "result"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "blocked",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "smallest_unblock_step": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
