{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "status",
    "checks",
    "summary"
  ],
  "properties": {
    "milestone_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "name",
          "result"
        ],
        "additionalProperties": true
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "name",
          "result"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "blocked",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "smallest_unblock_step": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
